<html>

<head>
    <link rel="stylesheet" href="../styles/dashboard.css">
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>

<body class=" h-screen w-full flex justify-center items-center">
    <!-- Dashboard -->
    <section class="h-screen w-full">
        <div class="w-full flex justify-end bg-black">
            <button data-drawer-target="default-sidebar" data-drawer-toggle="default-sidebar"
                aria-controls="default-sidebar" type="button"
                class="inline-flex items-end  p-2 mt-2 ms-3 text-sm text-gray-500 rounded-lg sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600">
                <span class="sr-only">Open sidebar</span>
                <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"
                    xmlns="http://www.w3.org/2000/svg">
                    <path clip-rule="evenodd" fill-rule="evenodd"
                        d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z">
                    </path>
                </svg>
            </button>
        </div>

        <aside id="default-sidebar"
            class="fixed top-0 left-0 z-40 w-64 h-screen transition-transform -translate-x-full sm:translate-x-0"
            aria-label="Sidebar">
            <div class="h-full px-3 py-4 overflow-y-auto bg-black">
                <% if (user) { %>
                    <h1 class="text-white font-bold mb-4">
                        <%= user.username %>
                    </h1>

                    <% } else { %>
                        <h1 class="text-white font-bold mb-4">
                            No hay usuario
                        </h1>

                        <% } %>

                            <ul class="space-y-2 font-medium">
                                <li>
                                    <a href="/"
                                        class="flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24"
                                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="icon icon-tabler icons-tabler-outline icon-tabler-home">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
                                            <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
                                            <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />
                                        </svg>
                                        <span class="ms-3">Dashboard</span>
                                    </a>
                                </li>

                                <% if (user.isAdmin) { %>

                                    <li>
                                        <a href="/schedule"
                                            class="flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"
                                                fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round"
                                                class="icon icon-tabler icons-tabler-outline icon-tabler-clock-24">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M3 12a9 9 0 0 0 5.998 8.485m12.002 -8.485a9 9 0 1 0 -18 0" />
                                                <path d="M12 7v5" />
                                                <path
                                                    d="M12 15h2a1 1 0 0 1 1 1v1a1 1 0 0 1 -1 1h-1a1 1 0 0 0 -1 1v1a1 1 0 0 0 1 1h2" />
                                                <path d="M18 15v2a1 1 0 0 0 1 1h1" />
                                                <path d="M21 15v6" />
                                            </svg>
                                            <span class="ms-3">Horarios</span>
                                        </a>
                                    </li>
                                    <% } else { %>

                                        <% } %>

                                            <% if (user.isAdmin) { %>
                                                <!-- <li>
                                                    <a href="/users"
                                                        class="flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group">
                                                        <svg class="shrink-0 w-5 h-5 text-gray-500 transition duration-75 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white"
                                                            aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                                                            fill="currentColor" viewBox="0 0 20 18">
                                                            <path
                                                                d="M14 2a3.963 3.963 0 0 0-1.4.267 6.439 6.439 0 0 1-1.331 6.638A4 4 0 1 0 14 2Zm1 9h-1.264A6.957 6.957 0 0 1 15 15v2a2.97 2.97 0 0 1-.184 1H19a1 1 0 0 0 1-1v-1a5.006 5.006 0 0 0-5-5ZM6.5 9a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM8 10H5a5.006 5.006 0 0 0-5 5v2a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-2a5.006 5.006 0 0 0-5-5Z" />
                                                        </svg>
                                                        <span class="flex-1 ms-3 whitespace-nowrap">Users</span>
                                                    </a>
                                                </li> -->
                                                <% } else { %>

                                                    <% } %>

                                                        <% if (!user.isAdmin) { %>
                                                            <li>
                                                                <a href="/permissions"
                                                                    class="flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group">
                                                                    <svg class="w-6 h-6 text-gray-800 dark:text-white"
                                                                        aria-hidden="true"
                                                                        xmlns="http://www.w3.org/2000/svg" width="24"
                                                                        height="24" fill="currentColor"
                                                                        viewBox="0 0 24 24">
                                                                        <path
                                                                            d="M16 10c0-.55228-.4477-1-1-1h-3v2h3c.5523 0 1-.4477 1-1Z" />
                                                                        <path
                                                                            d="M13 15v-2h2c1.6569 0 3-1.3431 3-3 0-1.65685-1.3431-3-3-3h-2.256c.1658-.46917.256-.97405.256-1.5 0-.51464-.0864-1.0091-.2454-1.46967C12.8331 4.01052 12.9153 4 13 4h7c.5523 0 1 .44772 1 1v9c0 .5523-.4477 1-1 1h-2.5l1.9231 4.6154c.2124.5098-.0287 1.0953-.5385 1.3077-.5098.2124-1.0953-.0287-1.3077-.5385L15.75 16l-1.827 4.3846c-.1825.438-.6403.6776-1.0889.6018.1075-.3089.1659-.6408.1659-.9864v-2.6002L14 15h-1ZM6 5.5C6 4.11929 7.11929 3 8.5 3S11 4.11929 11 5.5 9.88071 8 8.5 8 6 6.88071 6 5.5Z" />
                                                                        <path
                                                                            d="M15 11h-4v9c0 .5523-.4477 1-1 1-.55228 0-1-.4477-1-1v-4H8v4c0 .5523-.44772 1-1 1s-1-.4477-1-1v-6.6973l-1.16797 1.752c-.30635.4595-.92722.5837-1.38675.2773-.45952-.3063-.5837-.9272-.27735-1.3867l2.99228-4.48843c.09402-.14507.2246-.26423.37869-.34445.11427-.05949.24148-.09755.3763-.10887.03364-.00289.06747-.00408.10134-.00355H15c.5523 0 1 .44772 1 1 0 .5523-.4477 1-1 1Z" />
                                                                    </svg>


                                                                    <span
                                                                        class="flex-1 ms-3 whitespace-nowrap">Solicitar
                                                                        Permiso</span>
                                                                </a>
                                                            </li>
                                                            <% } else { %>

                                                                <% } %>

                                                                    <li>
                                                                        <form id="logoutForm" method="POST"
                                                                            class="flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group cursor-pointer">
                                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                                class="w-6 h-6" viewBox="0 0 24 24"
                                                                                fill="none" stroke="currentColor"
                                                                                stroke-width="2" stroke-linecap="round"
                                                                                stroke-linejoin="round"
                                                                                class="icon icon-tabler icons-tabler-outline icon-tabler-logout-2">
                                                                                <path stroke="none" d="M0 0h24v24H0z"
                                                                                    fill="none" />
                                                                                <path
                                                                                    d="M10 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2" />
                                                                                <path d="M15 12h-12l3 -3" />
                                                                                <path d="M6 15l-3 -3" />
                                                                            </svg>
                                                                            <button type="submit" class="ms-3">Cerrar
                                                                                Sesión</button>
                                                                        </form>
                                                                    </li>

                            </ul>
            </div>
        </aside>

        <div class="p-4 sm:ml-64">
            <h1 class="text-start font-bold text-2xl">Dashboard</h1>


            <% if (!user.isAdmin) { %>
                <div class="grid lg:grid-cols-3 grid-cols-1 mt-4 gap-4">
                    <div class="border-black border-1 text-start p-2 shadow-lg gap-4 flex justify-between">
                        <div>
                            <h3 class="font-semibold text-md">Asistencias a Tiempo</h3>
                            <p>
                                <%= totalPresent %>
                            </p>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-green-700" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-clock">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                            <path d="M12 7v5l3 3" />
                        </svg>
                    </div>

                    <div class="border-black border-1 text-start p-2 shadow-lg gap-4 flex justify-between">
                        <div>
                            <h3 class="font-semibold text-md">Registros Tardes</h3>
                            <p>
                                <%= totalLate %>
                            </p>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-yellow-500" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-alarm">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M12 13m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                            <path d="M12 10l0 3l2 0" />
                            <path d="M7 4l-2.75 2" />
                            <path d="M17 4l2.75 2" />
                        </svg>
                    </div>


                    <div class="border-black border-1 text-start p-2 shadow-lg gap-4 flex justify-between">
                        <div>
                            <h3 class="font-semibold text-md">Registro de Ausencias</h3>
                            <p>
                                <%= totalAbsent %>
                            </p>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-red-700" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-clock-x">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M20.926 13.15a9 9 0 1 0 -7.835 7.784" />
                            <path d="M12 7v5l2 2" />
                            <path d="M22 22l-5 -5" />
                            <path d="M17 22l5 -5" />
                        </svg>
                    </div>

                </div>
                <div class="mt-4 border-1 shadow-lg h-full p-2">
                    <div>
                        <h2 class="text-lg font-semibold">Mi Horario Laboral</h2>
                        <div class="grid lg:grid-cols-3 grid-cols-1 m-4 gap-4">
                            <% allUserSchedules.forEach(dataDay=> { %>
                                <div
                                    class="border-2 bg-slate-300 shadow-lg rounded-md h-[100px] p-4 flex justify-between">
                                    <div>
                                        <h5><strong>Día:</strong>
                                            <%= dataDay.day %>
                                        </h5>
                                        <div>
                                            <h5><strong>Horario</strong></h5>
                                            <div class="flex gap-4">
                                                <p class="text-black"><strong>Inicio:</strong>
                                                    <%= dataDay.startTime %>
                                                </p>
                                                <p><strong>Fin:</strong>
                                                    <%= dataDay.endTime %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="text-2xl">🎉</p>

                                </div>
                                <% }) %>

                        </div>
                    </div>


                    <div class="mb-2">
                        <hr>
                        <h5 class="text-lg font-semibold">Hoy</h5>
                    </div>
                    <div class="flex flex-1 flex-col items-center">
                        <% if (userSchedule && userSchedule.day && userSchedule.startTime && userSchedule.endTime) { %>
                            <div class="text-orange-500 ">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" viewBox="0 0 24 24"
                                    fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-sun">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path
                                        d="M12 19a1 1 0 0 1 .993 .883l.007 .117v1a1 1 0 0 1 -1.993 .117l-.007 -.117v-1a1 1 0 0 1 1 -1z" />
                                    <path
                                        d="M18.313 16.91l.094 .083l.7 .7a1 1 0 0 1 -1.32 1.497l-.094 -.083l-.7 -.7a1 1 0 0 1 1.218 -1.567l.102 .07z" />
                                    <path
                                        d="M7.007 16.993a1 1 0 0 1 .083 1.32l-.083 .094l-.7 .7a1 1 0 0 1 -1.497 -1.32l.083 -.094l.7 -.7a1 1 0 0 1 1.414 0z" />
                                    <path
                                        d="M4 11a1 1 0 0 1 .117 1.993l-.117 .007h-1a1 1 0 0 1 -.117 -1.993l.117 -.007h1z" />
                                    <path
                                        d="M21 11a1 1 0 0 1 .117 1.993l-.117 .007h-1a1 1 0 0 1 -.117 -1.993l.117 -.007h1z" />
                                    <path
                                        d="M6.213 4.81l.094 .083l.7 .7a1 1 0 0 1 -1.32 1.497l-.094 -.083l-.7 -.7a1 1 0 0 1 1.217 -1.567l.102 .07z" />
                                    <path
                                        d="M19.107 4.893a1 1 0 0 1 .083 1.32l-.083 .094l-.7 .7a1 1 0 0 1 -1.497 -1.32l.083 -.094l.7 -.7a1 1 0 0 1 1.414 0z" />
                                    <path
                                        d="M12 2a1 1 0 0 1 .993 .883l.007 .117v1a1 1 0 0 1 -1.993 .117l-.007 -.117v-1a1 1 0 0 1 1 -1z" />
                                    <path
                                        d="M12 7a5 5 0 1 1 -4.995 5.217l-.005 -.217l.005 -.217a5 5 0 0 1 4.995 -4.783z" />
                                </svg>
                            </div>
                            <p><strong>Día:</strong>
                                <%= userSchedule.day %>
                            </p>
                            <p><strong>Horario:</strong>
                                <%= userSchedule.startTime %> - <%= userSchedule.endTime %>
                            </p>

                            <% if (attendanceStatus==="No tienes un horario asignado." ||
                                attendanceStatus==="No es tu día laboral." ||
                                attendanceStatus==="Fuera de horario laboral." ) { %>
                                <p class="text-red-500 font-bold">
                                    <%= attendanceStatus %>
                                </p>
                                <% } else if (attendanceStatus==="Asistencia registrada." ) { %>
                                    <p class="text-green-500 font-bold">
                                        <%= attendanceStatus %>
                                    </p>
                                    <% } else { %>
                                        <form action="/attendance" method="POST">
                                            <button type="submit" class="bg-orange-500 text-black p-2 rounded">Registrar
                                                Asistencia</button>
                                        </form>
                                        <% } %>

                                            <% } else { %>
                                                <p class="text-red-500">No tienes un horario asignado.</p>
                                                <% } %>
                    </div>

                    <% } else { %>
                        <div class="grid lg:grid-cols-3 grid-cols-1 mt-4 gap-4">
                            <div class="border-black border-1 text-start p-2 shadow-lg gap-4 flex justify-between">
                                <div>
                                    <h3 class="font-semibold text-md">Usuarios en la plataforma</h3>
                                    <p>
                                        <%= plataformUser %>
                                    </p>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-500"
                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round"
                                    class="icon icon-tabler icons-tabler-outline icon-tabler-users">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                                    <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                    <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
                                </svg>
                            </div>

                            <div class="border-black border-1 text-start p-2 shadow-lg gap-4 flex justify-between">
                                <div>
                                    <h3 class="font-semibold text-md">Permisos aceptados</h3>
                                    <p>
                                        <%= grantedPermissions %>
                                    </p>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-green-700"
                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round"
                                    class="icon icon-tabler icons-tabler-outline icon-tabler-user-check">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                                    <path d="M6 21v-2a4 4 0 0 1 4 -4h4" />
                                    <path d="M15 19l2 2l4 -4" />
                                </svg>
                            </div>

                            <div class="border-black border-1 text-start p-2 shadow-lg gap-4 flex justify-between">
                                <div>
                                    <h3 class="font-semibold text-md">Permisos sin aceptar</h3>
                                    <p>
                                        <%= noGrantedPermissions %>
                                    </p>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-700" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="icon icon-tabler icons-tabler-outline icon-tabler-user-minus">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                                    <path d="M6 21v-2a4 4 0 0 1 4 -4h4c.348 0 .686 .045 1.009 .128" />
                                    <path d="M16 19h6" />
                                </svg>
                            </div>




                        </div>
                        <hr class="mt-4">
                        <div class="mt-2">
                            <h2 class="font-bold text-xl">Permisos Solicitados</h2>
                            <div>
                                <% allPermissions.forEach(permissionData=> { %>
                                    <div class="border-1 border rounded-md shadow-lg black p-2">
                                        <div class="flex justify-between">
                                            <div class="flex items-center gap-4">
                                                <h5 class="font-bold">
                                                    <%= permissionData.username %>
                                                </h5>
                                                <p>👤</p>
                                            </div>

                                            <div class="inline-flex">Estado:
                                                <% if (permissionData.status=='Pending' ) { %>
                                                    <p class="text-red-800 ms-2 font-semibold">Pendiente</p>
                                                    <% } %>
                                            </div>

                                        </div>
                                        <div>
                                            <h5 class="text-xs"><strong>Motivo:</strong></h5>
                                            <p class="text-lg text-sm font-normal">
                                                <%= permissionData.reason %>
                                            </p>
                                        </div>
                                        <div class="flex justify-between items-center">
                                            <div class="flex gap-4 items-center">
                                                <p><strong>Desde:</strong>
                                                    <%= permissionData.startDate %>
                                                </p>
                                                <p><strong>Hasta:</strong>
                                                    <%= permissionData.endDate %>
                                                </p>
                                            </div>
                                            <div>
                                                <button
                                                    onclick="updatePermission('<%= permissionData._id %>', 'Approved')"
                                                    class="bg-green-700 px-4 rounded-md py-2 text-white">Otorgar</button>
                                                <button
                                                    onclick="updatePermission('<%= permissionData._id %>', 'Rejected')"
                                                    class="bg-red-700 px-4 py-2 text-white rounded-md">Rechazar</button>

                                            </div>
                                        </div>

                                    </div>
                                    <% }) %>
                            </div>
                        </div>




                        <% } %>

                </div>



        </div>



    </section>

    <script>
        function updatePermission(permissionId, status) {
            fetch(`/permissions/${permissionId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ status: status })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload(); // Recargar la página para mostrar el estado actualizado
                    } else {
                        alert('Error al actualizar el permiso');
                    }
                })
                .catch(error => {
                    console.error(error);
                    alert('Error al actualizar el permiso');
                });
        }

    </script>
    <script>


        document.getElementById('logoutForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const response = await fetch('/logout', {
                method: 'POST'
            });
            if (response.ok) {
                window.location.href = '/login';
            }
        });


        document.addEventListener("DOMContentLoaded", function () {
            const toggleButton = document.querySelector("[data-drawer-toggle]");
            const sidebar = document.getElementById("default-sidebar");

            toggleButton.addEventListener("click", function () {
                sidebar.classList.toggle("-translate-x-full");
            });
        })
    </script>


</body>

</html>